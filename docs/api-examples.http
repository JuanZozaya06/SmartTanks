@api = https://us-east1-smarttanks-830ba.cloudfunctions.net/api
@deviceId = smarttank-84f703123456
@deviceSecret = reemplazar-secreto
@userToken = reemplazar-id-token-firebase-auth
@tankId = smarttank-84f703123456:pressure-a

### Estado de la API
GET {{api}}/v1/health

### Contexto del usuario autenticado
GET {{api}}/v1/me/context
Authorization: Bearer {{userToken}}

### Crear la primera casa sin precrear tanques
POST {{api}}/v1/homes
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Casa principal",
  "timezone": "America/Caracas",
  "displayName": "Usuario"
}

### Asociar un SmartTank preaprovisionado
POST {{api}}/v1/homes/home_01/devices/claim
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "deviceId": "smarttank-84f703123456",
  "setupPin": "12345678",
  "label": "SmartTank del patio"
}

### Listar dispositivos asociados
GET {{api}}/v1/homes/home_01/devices
Authorization: Bearer {{userToken}}

### Configuración del dispositivo
GET {{api}}/v1/device/config
X-Device-Id: {{deviceId}}
Authorization: Bearer {{deviceSecret}}

### Lote idempotente con dos sensores
POST {{api}}/v1/device/readings/batch
Content-Type: application/json
X-Device-Id: {{deviceId}}
Authorization: Bearer {{deviceSecret}}

{
  "deviceId": "{{deviceId}}",
  "bootSessionId": "boot_01J_EXAMPLE",
  "readings": [
    {
      "sequence": 18422,
      "sensorId": "pressure-a",
      "observedAt": "2026-08-18T15:20:00Z",
      "timestampQuality": "verified",
      "elapsedMs": 910000,
      "pressureKpa": 13.4,
      "wifiRssi": -62
    },
    {
      "sequence": 18422,
      "sensorId": "pressure-b",
      "observedAt": "2026-08-18T15:20:00Z",
      "timestampQuality": "verified",
      "elapsedMs": 910000,
      "pressureKpa": 6.7,
      "wifiRssi": -62
    }
  ]
}

### Configurar medidas y presión de lleno de un tanque descubierto
PATCH {{api}}/v1/homes/home_01/tanks/{{tankId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Tanque del patio",
  "heightCm": 200,
  "diameterCm": 51,
  "fullPressureKpa": 19.6
}

### Histórico agregado de las últimas 24 horas
GET {{api}}/v1/tanks/{{tankId}}/readings?period=day
Authorization: Bearer {{userToken}}

### Histórico agregado de un rango explícito, máximo 31 días
GET {{api}}/v1/tanks/{{tankId}}/readings?from=2026-08-18T00:00:00Z&to=2026-08-19T00:00:00Z
Authorization: Bearer {{userToken}}

### Evento de arranque
POST {{api}}/v1/device/events
Content-Type: application/json
X-Device-Id: {{deviceId}}
Authorization: Bearer {{deviceSecret}}

{
  "deviceId": "{{deviceId}}",
  "eventType": "boot_started",
  "bootSessionId": "boot_01J_EXAMPLE",
  "sequence": 1,
  "elapsedMs": 1500,
  "metadata": {
    "resetReason": "power_on",
    "firmwareVersion": "1.0.0"
  }
}
