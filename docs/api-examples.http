@api = http://127.0.0.1:5001/smarttanks-830ba/us-east1/api
@deviceId = smarttank-84f703123456
@deviceSecret = reemplazar-secreto
@userToken = reemplazar-id-token-firebase-auth

### Estado de la API
GET {{api}}/v1/health

### Contexto del usuario autenticado
GET {{api}}/v1/me/context
Authorization: Bearer {{userToken}}

### Crear la primera casa y sus tanques
POST {{api}}/v1/homes
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Casa principal",
  "timezone": "America/Caracas",
  "displayName": "Usuario",
  "tanks": [
    {
      "name": "Tanque principal",
      "heightCm": 200,
      "diameterCm": 51,
      "capacityLiters": 408.6,
      "lowLevelPercentage": 25
    },
    {
      "name": "Tanque auxiliar",
      "heightCm": 200,
      "diameterCm": 51,
      "capacityLiters": 408.6,
      "lowLevelPercentage": 25
    }
  ]
}

### Asociar un SmartTank preaprovisionado
POST {{api}}/v1/homes/home_01/devices/claim
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "deviceId": "smarttank-84f703123456",
  "setupPin": "12345678",
  "label": "SmartTank del patio"
}

### Listar dispositivos asociados
GET {{api}}/v1/homes/home_01/devices
Authorization: Bearer {{userToken}}

### Configuración del dispositivo
GET {{api}}/v1/device/config
X-Device-Id: {{deviceId}}
Authorization: Bearer {{deviceSecret}}

### Lote idempotente con ambos canales
POST {{api}}/v1/device/readings/batch
Content-Type: application/json
X-Device-Id: {{deviceId}}
Authorization: Bearer {{deviceSecret}}

{
  "deviceId": "{{deviceId}}",
  "bootSessionId": "boot_01J_EXAMPLE",
  "readings": [
    {
      "sequence": 18422,
      "tankChannel": "A",
      "observedAt": "2026-08-18T15:20:00Z",
      "timestampQuality": "verified",
      "elapsedMs": 910000,
      "pressureKpa": 13.4,
      "waterHeightCm": 136.6,
      "percentage": 68.3,
      "liters": 276,
      "wifiRssi": -62
    },
    {
      "sequence": 18422,
      "tankChannel": "B",
      "observedAt": "2026-08-18T15:20:00Z",
      "timestampQuality": "verified",
      "elapsedMs": 910000,
      "pressureKpa": 6.7,
      "waterHeightCm": 68.3,
      "percentage": 34.1,
      "liters": 139,
      "wifiRssi": -62
    }
  ]
}

### Evento de arranque
POST {{api}}/v1/device/events
Content-Type: application/json
X-Device-Id: {{deviceId}}
Authorization: Bearer {{deviceSecret}}

{
  "deviceId": "{{deviceId}}",
  "eventType": "boot_started",
  "bootSessionId": "boot_01J_EXAMPLE",
  "sequence": 1,
  "elapsedMs": 1500,
  "metadata": {
    "resetReason": "power_on",
    "firmwareVersion": "1.0.0"
  }
}
