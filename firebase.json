{
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "runtime": "python312",
      "ignore": [
        ".venv*",
        "venv*",
        "__pycache__",
        ".pytest_cache",
        "tests"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
